# Copy to .env on the server / set in Render — never commit real secrets
DATABASE_URL=
DIRECT_URL=
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend.vercel.app
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OWNER_EMAIL=admin@pricewatch.app
OWNER_PASSWORD=
OWNER_NAME=PriceWatch Owner
REDIS_URL=
ENABLE_WORKER=true
SCRAPER_MODE=live
WORKER_CONCURRENCY=1
FREE_TIER=true
# Prefer HTTP; browser used only as fallback with short timeouts
# SCRAPE_HTTP_ONLY=true
# SCRAPERAPI_KEY=   # recommended for Amazon on Render free
